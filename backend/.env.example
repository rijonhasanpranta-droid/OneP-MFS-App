// ===================== OneP MFS - .env.example =====================

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/onep_mfs?schema=public

# Redis Configuration  
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-256-bits
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key
REFRESH_TOKEN_EXPIRY=30d

# Encryption
ENCRYPTION_KEY=your-aes-256-encryption-key-32-bytes-long

# Server
PORT=3000
NODE_ENV=development
APP_NAME=OneP-MFS
APP_URL=http://localhost:3000

# Frontend URLs (CORS)
FLUTTER_APP_URL=http://localhost
ADMIN_PANEL_URL=http://localhost:3001

# SMS OTP Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Alternative: SSL SMS API (Bangladesh)
SSL_SMS_API_KEY=your-ssl-sms-api-key
SSL_SMS_URL=https://sms.sslwireless.com/api/v3/send-sms

# Payment Gateway (SSLCOMMERZ)
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_API_URL=https://sandbox.sslcommerz.com

# External APIs
BILL_PAY_API_URL=https://api.billpay.com
BILL_PAY_API_KEY=your-api-key

MOBILE_RECHARGE_API_URL=https://api.recharge.com
MOBILE_RECHARGE_API_KEY=your-api-key

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=5

# Fraud Detection
FRAUD_DETECTION_ENABLED=true
MAX_TRANSACTIONS_PER_HOUR=10
ANOMOLY_SCORE_THRESHOLD=70

# Admin
ADMIN_EMAIL=admin@onep.com
ADMIN_PHONE=01700000000

# Database Backup (Optional)
BACKUP_ENABLED=true
BACKUP_INTERVAL=daily
BACKUP_PATH=/backups/database
