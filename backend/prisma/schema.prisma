// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== USER MANAGEMENT =====================

model User {
  id                String   @id @default(cuid())
  phone             String   @unique @db.VarChar(20)
  name              String   @db.VarChar(100)
  email             String?  @unique @db.VarChar(100)
  nid               String?  @unique @db.VarChar(20)  // ১৭ ডিজিট
  pin_hash          String?                             // এনক্রিপ্টেড 5 ডিজিট PIN
  kyc_status        KYCStatus @default(PENDING)       // PENDING, APPROVED, REJECTED
  kyc_verified_at   DateTime?
  biometric_enabled Boolean  @default(false)
  profile_photo_url String?  @db.VarChar(255)
  is_active         Boolean  @default(true)
  is_blocked        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  wallets           Wallet[]
  sent_transactions Transaction[] @relation("from_user")
  recv_transactions Transaction[] @relation("to_user")
  otps              OTP[]
  audit_logs        AuditLog[]
  agent             Agent?

  @@index([phone])
  @@index([kyc_status])
  @@index([created_at])
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ===================== WALLET MANAGEMENT =====================

model Wallet {
  id                String   @id @default(cuid())
  user_id           String   @unique
  balance           BigInt   @default(0)              // টাকা Paisa তে (100 Paisa = 1 TK)
  is_locked         Boolean  @default(false)
  locked_reason     String?  @db.VarChar(255)        // কেন লক করা হয়েছে
  total_sent        BigInt   @default(0)              // মোট পাঠানো
  total_received    BigInt   @default(0)              // মোট পাওয়া
  daily_limit       BigInt   @default(500000)        // প্রতিদিনের লিমিট (5000 TK)
  monthly_limit     BigInt   @default(5000000)       // প্রতি মাসের লিমিট (50000 TK)
  daily_sent_today  BigInt   @default(0)              // আজ পাঠানো হয়েছে
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([user_id])
  @@index([balance])
}

// ===================== TRANSACTION MANAGEMENT =====================

model Transaction {
  id                String   @id @default(cuid())
  trx_id            String   @unique @db.VarChar(50) // সিস্টেম জেনারেটেড ট্রানজেকশন ID
  type              TxnType                           // SEND, RECEIVE, CASH_IN, CASH_OUT, BILL_PAY, RECHARGE
  from_user_id      String?
  to_user_id        String?
  from_wallet_id    String?
  to_wallet_id      String?
  amount            BigInt                            // Paisa তে
  commission_amount BigInt   @default(0)              // এজেন্ট কমিশন
  total_amount      BigInt                            // Amount + Commission
  description       String?  @db.VarChar(255)
  status            TxnStatus @default(PENDING)      // PENDING, SUCCESS, FAILED, CANCELLED
  failure_reason    String?  @db.VarChar(255)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  completed_at      DateTime?

  // Relations
  from_user         User?    @relation("from_user", fields: [from_user_id], references: [id])
  to_user           User?    @relation("to_user", fields: [to_user_id], references: [id])
  from_wallet       Wallet?  @relation(fields: [from_wallet_id], references: [id])
  to_wallet         Wallet?  @relation(fields: [to_wallet_id], references: [id])
  
  @@index([trx_id])
  @@index([from_user_id])
  @@index([to_user_id])
  @@index([status])
  @@index([created_at])
  @@index([type])
}

enum TxnType {
  SEND              // P2P Transfer
  RECEIVE           // P2P Receive
  CASH_IN           // Bank থেকে Add Money
  CASH_OUT          // Agent এর কাছে Cash Out
  BILL_PAY          // বিল পরিশোধ
  RECHARGE          // মোবাইল রিচার্জ
  REFUND            // রিফান্ড
}

enum TxnStatus {
  PENDING           // অপেক্ষমাণ
  SUCCESS           // সফল
  FAILED            // ব্যর্থ
  CANCELLED         // বাতিল
}

// ===================== AGENT MANAGEMENT =====================

model Agent {
  id                    String   @id @default(cuid())
  user_id               String   @unique
  shop_name             String   @db.VarChar(100)
  shop_phone            String   @db.VarChar(20)
  shop_address          String   @db.Text
  nid_verified          Boolean  @default(false)
  commission_balance    BigInt   @default(0)           // এজেন্ট এর কমিশন ব্যালেন্স
  total_commission      BigInt   @default(0)           // মোট কমিশন পাওয়া
  commission_withdrawn  BigInt   @default(0)           // কমিশন উত্তোলন করা
  qr_code               String?  @db.VarChar(255)      // QR Code Data
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Relations
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_active])
}

// ===================== OTP MANAGEMENT =====================

model OTP {
  id        String   @id @default(cuid())
  user_id   String?
  phone     String   @db.VarChar(20)
  code      String   @db.VarChar(6)    // 6 ডিজিট OTP
  is_used   Boolean  @default(false)
  attempts  Int      @default(0)       // ভুল প্রচেষ্টা
  expires_at DateTime                  // OTP মেয়াদ শেষ
  created_at DateTime @default(now())

  // Relations
  user      User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([expires_at])
}

// ===================== AUDIT LOGGING (১০ বছর সংরক্ষণ) =====================

model AuditLog {
  id              String   @id @default(cuid())
  user_id         String
  action          String   @db.VarChar(100)     // LOGIN, SEND_MONEY, CASH_IN, etc.
  transaction_id  String?  @db.VarChar(50)
  old_balance     BigInt?
  new_balance     BigInt?
  ip_address      String?  @db.VarChar(50)
  user_agent      String?  @db.VarChar(255)
  status          String   @db.VarChar(20)     // SUCCESS, FAILED
  details         Json?                        // অতিরিক্ত ডাটা JSON এ
  created_at      DateTime @default(now())

  // Relations
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
}

// ===================== FRAUD DETECTION =====================

model SuspiciousActivity {
  id              String   @id @default(cuid())
  user_id         String
  activity_type   String   @db.VarChar(100)
  description     String   @db.Text
  risk_score      Int      @default(0)         // 0-100
  is_resolved     Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([user_id])
  @@index([risk_score])
}
